# Runtime environment
NODE_ENV=development
PORT=3000

# Supabase project and JWT issuer
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=equipamentos
SUPABASE_STORAGE_S3_ENDPOINT=https://rcbqbgihlhylovzapzpr.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=sa-east-1

# Prisma runtime connection through Supavisor (port 6543)
DATABASE_URL=

# Prisma migrations direct connection (port 5432)
DIRECT_URL=

# Comma-separated frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,https://emprest-ai.vercel.app

# Configure these only in the deploy secret manager; never commit their values.
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_ACCESS_KEY_ID=
# SUPABASE_STORAGE_SECRET_ACCESS_KEY=