# Runtime environment
NODE_ENV=development
PORT=3000

# Supabase project and JWT issuer
SUPABASE_URL=

# Prisma runtime connection through Supavisor (port 6543)
DATABASE_URL=

# Prisma migrations direct connection (port 5432)
DIRECT_URL=

# Comma-separated frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173